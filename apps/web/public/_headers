# cloudflare reads this from the assets root (apps/web/out/_headers) and never serves it as a file.
# the static export inlines react's hydration payload in <script> tags and there is no nonce in a build with
# no server, so script-src has to allow inline; everything else is locked to same-origin plus turnstile.
/*
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline' https://challenges.cloudflare.com; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'self'; frame-src https://challenges.cloudflare.com; frame-ancestors 'none'; base-uri 'self'; form-action 'self'; object-src 'none'
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: geolocation=(), microphone=(), camera=(), interest-cohort=()
  Cross-Origin-Opener-Policy: same-origin

# the queue and the evidence behind it are not for anyone else's index or cache
/admin
  X-Robots-Tag: noindex, nofollow
/s
  X-Robots-Tag: noindex, nofollow

# the published dataset is the one thing meant to be pulled from anywhere
/data/*
  Access-Control-Allow-Origin: *
