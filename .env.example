# crawler / actions side. copy to .env and run node with --env-file=.env (the cli does this for you)

# local | d1
DB_MODE=local
LOCAL_DB_PATH=.local/jd.db

# only for DB_MODE=d1
CF_ACCOUNT_ID=
CF_API_TOKEN=
D1_DATABASE_ID=

# local | r2
BLOB_MODE=local
LOCAL_BLOB_DIR=.local/blobs

# only for BLOB_MODE=r2 (s3 api)
R2_BUCKET=jd-reporter
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=

# optional: wayback save page now keys (archive.org account)
WAYBACK_ACCESS_KEY=
WAYBACK_SECRET_KEY=

# identify the crawler honestly
USER_AGENT=jd-reporter/0.1 (+https://example.org/methodology; contact@example.org)

